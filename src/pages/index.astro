---
import type { CardInfo } from '../components/Astro/ui/ContactCard/ContactCard.astro';

import ShareButton from '../components/Svelte/ui/ShareButton/ShareButton.svelte';
import ContactCard from '../components/Astro/ui/ContactCard/ContactCard.astro';
import cardLinksData from '../data/card-links.json';
import Layout from "../layouts/Layout.astro";

const cardLinks = cardLinksData as CardInfo[];

const generateEmailAddress = (user: string, sld: string, tld: string): (() => string) => {
	return () => {
		return `${user}@${sld}.${tld}`;
	};
};

cardLinks.map((card) => {
	if (card.serviceName === "Mail") {
		card.url = generateEmailAddress("contact", "moizlu", "com");
	}
});
---

<Layout title="もいずる | リンク集" faviconPath="/favicon.svg">
	<div class="flex flex-col justify-center items-center my-10">
		<img src="/logo/light/moizlu.svg" alt="logo" width={300} class="m-5 drop-shadow-zinc-800 drop-shadow-md" />
		<p class="m-5 text-6xl">もいずる</p>
		<p class="m-2 text-5xl">moizlu</p>

		<ShareButton client:load />

		<div class="flex flex-col justify-center items-stretch gap-1 w-90">
			{cardLinks.map((card) => <ContactCard {...card} />)}
		</div>
	</div>
</Layout>
