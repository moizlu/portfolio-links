---
import LinkCard from '../LinkCard/LinkCard.astro';
import CopyButton from '../../../Svelte/ui/CopyButton/CopyButton.svelte';
export interface CardInfo {
    lightIconPath: string;
    darkIconPath?: string;
    serviceName: string;
    userName: string;
    url: string | (() => string);
}

interface Props extends CardInfo {
}

let { lightIconPath, darkIconPath, serviceName, userName, url }: Props = Astro.props;

if (typeof url === "function") {
    url = url();
}

let viewUrl = url.startsWith("http") ? url : '#';
---

<div class="flex justify-center items-center">
    <LinkCard {lightIconPath} {darkIconPath} {serviceName} {userName} url={viewUrl} className="" />
    <CopyButton {url} client:load />
</div>
