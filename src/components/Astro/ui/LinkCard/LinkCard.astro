---
import clsx from 'clsx';

interface Props {
    lightIconPath: string;
    darkIconPath?: string;
    serviceName: string;
    userName: string;
    url: string;
    className?: string;
}
const { lightIconPath, darkIconPath, serviceName, userName, url, className }: Props = Astro.props;
---

<a class={clsx(`flex justify-start items-center w-full m-2 border-1
                transition-all duration-300
              hover:bg-zinc-800 hover:text-zinc-100 dark:hover:bg-zinc-100 dark:hover:text-zinc-800
              active:bg-zinc-800 active:text-zinc-100 dark:active:bg-zinc-100 dark:active:text-zinc-800
              `,
(url === '#') && "pointer-events-none", className)} href={url} target="_blank">
    <img src={lightIconPath} alt={`${serviceName}'s icon`} width={40} class={clsx("z-0 relative m-5 block drop-shadow-zinc-100 dark:drop-shadow-zinc-800 drop-shadow-sm", (darkIconPath) &&  "dark:hidden")} />
    {darkIconPath && <img src={darkIconPath} alt={`${serviceName}'s icon`} width={40} class="z-0 relative m-5 hidden drop-shadow-zinc-800 drop-shadow-sm dark:block hover:block" />}
    <div class="flex flex-col justify-center items-start">
        <p class="text-3xl m-1">{serviceName}</p>
        <p class="text-2xl m-1">{userName}</p>
    </div>
</a>