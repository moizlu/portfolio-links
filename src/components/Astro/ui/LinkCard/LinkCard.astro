---
import clsx from 'clsx';
import Icon from '../../../Svelte/ui/Icon/Icon.svelte'

interface Props {
    lightIconPath: string;
    darkIconPath?: string;
    serviceName: string;
    userName: string;
    url: string;
    className?: string;
}
const { lightIconPath, darkIconPath, serviceName, userName, url, className }: Props = Astro.props;
---

<a class={clsx(`group flex justify-start items-center w-full m-2 border-1
                transition-all duration-300
              hover:bg-accent hover:text-primary
              active:bg-accent active:text-primary
              `,
    (url === '#') && "pointer-events-none", className)} href={url} target="_blank">
    <Icon lightSrc={lightIconPath} darkSrc={darkIconPath ?? lightIconPath} width={40} class="z-0 relative m-3 xs:m-5 w-7 xs:w-10" lightImgClassName="group-hover:opacity-0 dark:group-hover:opacity-100 group-active:opacity-0 dark:group-active:opacity-100" darkImgClassName="dark:group-hover:opacity-0 dark:group-active:opacity-0" />
    <div class="flex flex-col justify-center items-start">
        <p class="text-xl xs:text-3xl m-1">{serviceName}</p>
        <p class="text-lg xs:text-2xl m-1">{userName}</p>
    </div>
</a>